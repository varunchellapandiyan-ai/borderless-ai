# BORDERLESS AI Environment Configuration
# Copy this file to .env and provide your actual credentials

# Google Gemini API Key (Structured extraction & negotiation intelligence)
# If empty or invalid, the app gracefully falls back to deterministic Demo Mode with clear labels
GEMINI_API_KEY=

# PayPal Developer Sandbox Credentials (Orders API v2)
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Database & Security
DATABASE_URL=sqlite:///./borderless_ai.db
SECRET_KEY=borderless-dev-secret-key-change-in-production-2025
FRONTEND_URL=http://localhost:5173

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
